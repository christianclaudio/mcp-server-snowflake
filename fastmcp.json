{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "path": "src/snowflake_mcp/server.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "dependencies": [
      "mcp>=2.3.0",
      "fastmcp>=4.1.0",
      "snowflake-connector-python>=4.8.0",
      "snowflake-core>=1.13.2",
      "pydantic>=2.13.5",
      "cryptography>=50.0.2",
      "python-dotenv>=1.2.3",
      "tomli>=2.0.1; python_version < '3.11'"
    ]
  },
  "deployment": {
    "transport": "stdio",
    "log_level": "INFO"
  }
}
