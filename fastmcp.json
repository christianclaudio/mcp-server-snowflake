{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "path": "src/snowflake_mcp/server.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "dependencies": [
      "mcp>=2.3.0",
      "fastmcp>=4.1.7",
      "certifi>=2026.10.23",
      "snowflake-connector-python>=5.2.0",
      "snowflake-core>=1.14.0",
      "pydantic>=2.14.3",
      "cryptography>=50.0.2",
      "python-dotenv>=1.2.4"
    ]
  },
  "deployment": {
    "transport": "stdio",
    "log_level": "INFO"
  }
}
