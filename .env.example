# ==============================================================================
# Snowflake MCP Server Environment Configuration Example
# ==============================================================================

# Authentication & Connection (Optional if ~/.snowflake/connections.toml is used)
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-login-name
SNOWFLAKE_ROLE=ANALYST_ROLE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=your-database
SNOWFLAKE_SCHEMA=PUBLIC

# Connection Name (Inherits from ~/.snowflake/connections.toml)
SNOWFLAKE_CONNECTION_NAME=default

# Authentication Methods:
# 1. Programmatic Access Token (PAT) / OAuth:
# SNOWFLAKE_AUTHENTICATOR=PROGRAMMATIC_ACCESS_TOKEN
# SNOWFLAKE_TOKEN=your-token-here

# 2. Key-Pair Authentication:
# SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your-passphrase

# 3. Password:
# SNOWFLAKE_PASSWORD=your-password

# Safety & Controls (Defaults to read-only for security)
SNOWFLAKE_MCP_READONLY=1
SNOWFLAKE_QUERY_TIMEOUT=120
SNOWFLAKE_MAX_ROWS=1000
